          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml" />
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="AddTest" ObjectId="5ebd16ac-f29c-4f8c-af24-a6b6bfa35819">
              <interface>
                <inputVars>
                  <variable name="UnitTest">
                    <type>
                      <derived name="I_UnitTest" />
                    </type>
                  </variable>
                </inputVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">IF Count &lt;= MaxTests THEN
    Tests[Count]           := UnitTest;
    TestStatus[Count].Name := UnitTest.Name;
    Count                  := Count + 1;
END_IF
</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD AddTest
VAR_INPUT
	UnitTest : I_UnitTest;
END_VAR
</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="ClearTests" ObjectId="835dd897-a63a-408f-ba98-7b759c4bd8f6">
              <interface />
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">FOR i := 0 TO MaxTests DO
    Tests[i] := 0;
END_FOR
Count          := 0;
FailedCount    := 0;
CompletedCount := 0;
</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD ClearTests
VAR_INPUT
END_VAR
</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="CyclicUpdate" ObjectId="96e7c6f8-6766-4cc1-aafc-6e0c6696f116">
              <interface />
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">FailedCount    := 0;
CompletedCount := 0;
DisabledCount  := 0;

IF Count &gt; 0 AND Count &lt;= MaxTests THEN
    FOR i := 0 TO Count DO
        IF Tests[i] = 0 THEN
            TestStatus[i].Status := E_TestStatus.Unknown; 
			
        ELSIF Tests[i].TestDisabled THEN
            TestStatus[i].Status := E_TestStatus.Disabled; 
            F_Inc(DisabledCount);
			
        ELSE
            Tests[i].RunTest();
            IF Tests[i].TestCompleted THEN
				IF Tests[i].TestFailed THEN
					TestStatus[i].Status := E_TestStatus.Failed; 
					F_Inc(FailedCount);
				ELSE
					TestStatus[i].Status := E_TestStatus.Passed; 
				END_IF
                F_Inc(CompletedCount);
			ELSE
					TestStatus[i].Status := E_TestStatus.Running; 
            END_IF
			
        END_IF
    END_FOR
    TestsCompleted := (CompletedCount + DisabledCount = Count);
    IF RisingEdge1.Test(TestsCompleted) THEN
        DefaultLogger.LogInfo(SourceInfo, FormatString2('%d tests completed, %d tests failed', F_INT(CompletedCount), F_INT(FailedCount)));
    END_IF
END_IF
</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD CyclicUpdate
VAR_INST
    RisingEdge1 : T_RisingEdge;
END_VAR
</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="DisableTest" ObjectId="ab151484-63d2-43f3-8829-22e468606fd1">
              <interface>
                <inputVars>
                  <variable name="TestIndex">
                    <type>
                      <INT />
                    </type>
                  </variable>
                  <variable name="Disable">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                </inputVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">IF TestIndex &gt;= 0 AND TestIndex &lt;= Count THEN
    Tests[i].TestDisabled := Disable;
END_IF
</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD DisableTest
VAR_INPUT
    TestIndex : INT;
    Disable   : BOOL;
END_VAR
</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="Retest" ObjectId="444061de-9436-4d30-a32a-62cd98530e32">
              <interface>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/attributes" handleUnknown="implementation">
                    <Attributes>
                      <Attribute Name="TcRpcEnable" Value="" />
                    </Attributes>
                  </data>
                </addData>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">IF Count &gt; 0 AND Count &lt;= MaxTests THEN
    FOR i := 0 TO Count DO
        IF Tests[i] = 0 THEN
            ; // ignore
        ELSIF Tests[i].TestDisabled THEN
            ; // ignore
        ELSE
            Tests[i].Retest();
        END_IF
    END_FOR
END_IF
</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">{attribute 'TcRpcEnable'} 
METHOD Retest
VAR_INPUT
END_VAR
</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>

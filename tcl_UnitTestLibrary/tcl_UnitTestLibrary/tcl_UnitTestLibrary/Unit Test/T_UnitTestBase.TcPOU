    <Method Name="AssertEquals_LREAL" Id="{0e4ee858-c05e-426c-a0eb-481c1ac21bf1}" FolderPath="Methods\Assertions\">
      <Declaration><![CDATA[METHOD PROTECTED AssertEquals_LREAL : BOOL
VAR_INPUT
    Expected : LREAL;
    Actual   : LREAL;
    Delta    : LREAL;
    Message  : T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ABS(Expected - Actual) > Delta THEN
    tcl_BaseClasses.DefaultLogger.LogError(SourceInfo,
                                           F_FormatString3('%s: expected= %.3f, actual= %.3f',
                                                         F_STRING(Message),
                                                         F_LREAL(Expected),
                                                         F_LREAL(Actual)));
    _Failed := TRUE;
    RETURN;
END_IF

AssertEquals_LREAL := TRUE;
]]></ST>
      </Implementation>
    </Method>

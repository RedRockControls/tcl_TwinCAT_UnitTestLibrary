<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="T_UnitTestBase" Id="{db1f4e28-4a18-401b-8b29-e7f500ef63dc}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'reflection'}
FUNCTION_BLOCK ABSTRACT T_UnitTestBase
VAR
    {attribute 'instance-path'}
    {attribute 'no_init'}
    {attribute 'analysis' := '-33'} // Inhibit unused variable warning
    InstanceName : T_MaxString;     // Initialised with the instance name

    Project    : T_MaxString;
    Plc        : T_MaxString;
    TestName   : T_MaxString;
    SourceInfo : FB_TcSourceInfo := (sName := 'Unknown');

    _ElapsedTime : LREAL;
    _TestStatus  : E_TestStatus;
    _Enabled     : BOOL := TRUE;
    _Failed      : BOOL;
    _Completed   : BOOL;
    State        : INT;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Methods" Id="{a5772276-00c5-43a4-85c1-e780c7c7de3b}">
      <Folder Name="Assertions" Id="{eeb32758-3083-4449-8104-3d7cd077ec0c}" />
    </Folder>
    <Folder Name="Properties" Id="{eb7e9c1f-ae66-405a-820c-688b53e1a9a9}" />
    <Method Name="Abort" Id="{ea07d044-ff34-41be-8670-cc5c0235ccb1}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD Abort
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_TestStatus  := E_TestStatus.Aborted;
_Failed      := FALSE;
_Completed   := FALSE;
State        := 0;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AssertEquals_ANY" Id="{8c39ac6a-e3a4-4e64-8b71-f758c94e977f}" FolderPath="Methods\Assertions\">
      <Declaration><![CDATA[METHOD PROTECTED AssertEquals_ANY : BOOL
VAR_INPUT
    Expected : ANY;
    Actual   : ANY;
    Message  : T_MaxString;
END_VAR
VAR
    ComparisonResult : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ComparisonResult := MEMCMP(pBuf1 := Expected.pValue,
                           pBuf2 := Actual.pValue,
                           n     := DINT_TO_UDINT(Actual.diSize));

IF Expected.TypeClass <> Actual.TypeClass THEN
    DefaultLogger.LogError(SourceInfo, F_FormatStringEx1('Assertion Failed - %s', Message));
    _Failed := TRUE;
    RETURN;

ELSIF Expected.diSize <> Actual.diSize THEN
    DefaultLogger.LogError(SourceInfo, F_FormatStringEx1('Assertion Failed - %s', Message));
    _Failed := TRUE;
    RETURN;

ELSIF ComparisonResult <> 0 THEN
    DefaultLogger.LogError(SourceInfo, F_FormatStringEx1('Assertion Failed - %s', Message));
    _Failed := TRUE;
    RETURN;
END_IF

AssertEquals_ANY := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AssertEquals_BLOB" Id="{70e85b6e-d3ef-4918-85de-6a67d793469f}" FolderPath="Methods\Assertions\">
      <Declaration><![CDATA[METHOD AssertEquals_BLOB : BOOL
VAR_INPUT
    Expected : ANY;
    Actual   : ANY;
    Message  : T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF
    Expected.diSize <> Actual.diSize
THEN
    tcl_BaseClasses.DefaultLogger.LogError(SourceInfo,
                                           F_FormatString1('%s: Sizes differ',
                                                         F_STRING(Message)));
    _Failed := TRUE;
    RETURN;

ELSIF
    Expected.TypeClass <> Actual.TypeClass
THEN
    tcl_BaseClasses.DefaultLogger.LogError(SourceInfo,
                                           F_FormatString1('%s: Type classes differ',
                                                         F_STRING(Message)));
    _Failed := TRUE;
    RETURN;

ELSIF
    MEMCMP(pBuf1 := Expected.pValue, // TODO - convert to function
           pBuf2 := Actual.pValue,
           n     := DINT_TO_UDINT(Actual.diSize)) <>
    0
THEN
    tcl_BaseClasses.DefaultLogger.LogError(SourceInfo,
                                           F_FormatString1('%s: Contents differ',
                                                         F_STRING(Message)));
    _Failed := TRUE;
    RETURN;
ELSE
    AssertEquals_BLOB := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AssertEquals_BOOL" Id="{9b94f5a5-3f4f-4415-b23b-6241a645ab07}" FolderPath="Methods\Assertions\">
      <Declaration><![CDATA[METHOD PROTECTED AssertEquals_BOOL : BOOL
VAR_INPUT
    Expected : BOOL;
    Actual   : BOOL;
    Message  : T_MaxString;
END_VAR
VAR
    ExpectedAsString : STRING;
    ActualAsString   : STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Expected <> Actual THEN
    ExpectedAsString := BOOL_TO_STRING(Expected);
    ActualAsString   := BOOL_TO_STRING(Actual);
    tcl_BaseClasses.DefaultLogger.LogError(SourceInfo,
                                           F_FormatString3('%s: expected=%s, actual=%s',
                                                           F_STRING(Message),
                                                           F_STRINGEX(ExpectedAsString),
                                                           F_STRINGEX(ActualAsString)));
    _Failed := TRUE;
    RETURN;
END_IF

AssertEquals_BOOL := TRUE;
]]></ST>
      </Implementation>
    </Method>

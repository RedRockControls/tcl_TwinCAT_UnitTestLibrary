<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="T_MessageBuffer" Id="{0831817c-2bce-4eba-8fb7-0bb4a1b8bed8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK T_MessageBuffer
VAR
	MessageCount : UINT;
	Messages : ARRAY[0..MaxMessages] OF T_MaxString;
END_VAR
VAR CONSTANT
	MaxMessages : UINT := 99;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AddMessage" Id="{fb41f5fe-e532-4663-a783-6d3d57ee1d19}">
      <Declaration><![CDATA[METHOD AddMessage : BOOL
VAR_INPUT
	Message : T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF MessageCount < MaxMessages THEN
	Messages[MessageCount] := Message;
	F_Inc(MessageCount);
	AddMessage := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetMessage" Id="{59e6a2c0-20a8-426b-8846-6492a52c6acc}">
      <Declaration><![CDATA[METHOD GetMessage : T_MaxString
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF MessageCount > 0 THEN
    GetMessage := Messages[0];
	F_Dec(MessageCount);		
	IF MessageCount > 0 THEN
		MEMMOVE(destAddr :=ADR(Messages[0]),
				srcAddr  :=ADR(Messages[1]),
				n        :=MessageCount * SIZEOF(T_MaxString));
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="LogCritical" Id="{40522d29-65f5-4741-aed6-a7bf0497d52a}">
      <Declaration><![CDATA[METHOD LogCritical
VAR_INPUT
	Source	: T_MaxString;
	Message	: T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AddMessage(Message);]]></ST>
      </Implementation>
    </Method>
    <Method Name="LogDebug" Id="{3f59864b-a0aa-4782-9e60-9648fc8b6e6f}">
      <Declaration><![CDATA[METHOD LogDebug
VAR_INPUT
	Source	: T_MaxString;
	Message	: T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AddMessage(Message);]]></ST>
      </Implementation>
    </Method>
    <Method Name="LogError" Id="{b3bee4a5-140a-47e0-9e56-65449d588ef7}">
      <Declaration><![CDATA[METHOD LogError
VAR_INPUT
	Source	: T_MaxString;
	Message	: T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AddMessage(Message);]]></ST>
      </Implementation>
    </Method>
    <Method Name="LogInfo" Id="{42294517-a020-41e0-9a8e-eabf77d649f2}">
      <Declaration><![CDATA[METHOD LogInfo
VAR_INPUT
	Source	: T_MaxString;
	Message	: T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AddMessage(Message);]]></ST>
      </Implementation>
    </Method>
    <Method Name="LogWarning" Id="{7c66b23e-05c3-4737-96a5-c84b28004feb}">
      <Declaration><![CDATA[METHOD LogWarning
VAR_INPUT
	Source	: T_MaxString;
	Message	: T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AddMessage(Message);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>